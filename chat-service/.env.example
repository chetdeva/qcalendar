PORT=3001

# Postgres connection string (Supabase: Project > Connect > "Session pooler"). EMPTY = an embedded Postgres in ./data/pglite.
DATABASE_URL=
DATABASE_SSL=
DATABASE_CA_CERT=

# People sign in with Supabase; this is where their tokens are verified.
SUPABASE_URL=
# Trusted backends may create any conversation with this key. Generate: openssl rand -hex 32
API_KEY=

# Who may start a conversation: when a signed-in user asks for one, this URL gets POST {"memberIds":[...]} with the
# caller's own bearer token and must answer 2xx to allow it. EMPTY = users cannot start conversations (only the API key can).
CHAT_POLICY_URL=
