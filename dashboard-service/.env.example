PORT=3007

# Postgres connection string (Supabase: Project > Connect > "Session pooler"). EMPTY = an embedded Postgres in ./data/pglite.
DATABASE_URL=
DATABASE_SSL=
DATABASE_CA_CERT=

# People sign in with Supabase; this is where their tokens are verified.
SUPABASE_URL=

# The other services the dashboards read from (each call carries the signed-in person's own token).
CALENDAR_API_URL=http://localhost:3000
USERS_SERVICE_URL=http://localhost:3010
# Shared secret with users-service (its SERVICE_API_KEY): lets this service read a guardian's email for the parent-sync message.
# Generate: openssl rand -hex 32. Empty = grades still publish, parents are not emailed.
USERS_SERVICE_API_KEY=

# Parent-sync emails. SMTP e.g. AWS SES: smtps://USERNAME:PASSWORD@email-smtp.us-east-1.amazonaws.com:465 (empty = only logged)
SMTP_URL=
MAIL_FROM=Quanttoria <no-reply@example.com>
# Where the email tells the parent to look.
DASHBOARD_URL=http://localhost:3006
