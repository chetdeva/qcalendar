PORT=3010
# Your Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# The SECRET (service_role) key from Supabase > Project Settings > API Keys. Server-side only. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Where invited teachers land after clicking the email link (users-ui "accept invite" page)
INVITE_REDIRECT_URL=http://localhost:3003/accept-invite
# Shared secret with dashboard-service (its USERS_SERVICE_API_KEY): lets it read a student's guardian email to send parent updates.
# Unset = that endpoint does not exist. Generate: openssl rand -hex 32
SERVICE_API_KEY=
