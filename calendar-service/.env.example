PORT=3000

# --- Database -------------------------------------------------------------------------------------------------
# Postgres connection string. For Supabase: Project > Connect > "Session pooler" (works over IPv4), with your DB password.
# Leave EMPTY for local development: the service then runs an embedded Postgres in ./data/pglite (nothing to install).
DATABASE_URL=
# Encryption of the database connection: require (default for remote hosts), verify (also needs DATABASE_CA_CERT), off
DATABASE_SSL=
DATABASE_CA_CERT=

# --- Who may call it ------------------------------------------------------------------------------------------
# People sign in with Supabase; this is where their tokens are verified.
SUPABASE_URL=
# Trusted backends (the booking app, the current calendar-ui) use this key. Generate: openssl rand -hex 32
API_KEY=
# Legacy single-owner mode: the teacher the API key acts for when a request does not say whose calendar it is.
# Only needed by the current calendar-ui; remove it once that app uses real logins.
DEFAULT_OWNER_ID=

# --- Scheduling -----------------------------------------------------------------------------------------------
DEFAULT_TIMEZONE=America/New_York

# --- Invitation emails ----------------------------------------------------------------------------------------
# SMTP, e.g. AWS SES: smtps://USERNAME:PASSWORD@email-smtp.us-east-1.amazonaws.com:465
# Empty = emails are only logged, not sent.
SMTP_URL=
MAIL_FROM=SyncSchedule <no-reply@example.com>
# Shown in emails as where students accept or decline
CALENDAR_URL=
# Online classes get a unique room on this Jitsi server (use your own to avoid the public one)
MEETING_BASE_URL=https://meet.jit.si

# --- Webhooks to other apps (optional) ------------------------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=
