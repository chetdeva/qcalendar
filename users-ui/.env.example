# Supabase project (Project Settings > API). The publishable key is safe in the browser; NEVER put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# users-service (server-side calls only)
USERS_SERVICE_URL=http://localhost:3010
# Single sign-on: scope the session cookie to the parent domain in production, e.g. .example.com (leave empty locally)
NEXT_PUBLIC_COOKIE_DOMAIN=
# Other apps people may be sent back to after login (comma separated origins)
NEXT_PUBLIC_ALLOWED_RETURN_ORIGINS=http://localhost:3002
NEXT_PUBLIC_CALENDAR_URL=http://localhost:3002
