# Required: long random string. Generate with: openssl rand -hex 32
API_KEY=
# Public https URL of this service (used for the Google OAuth redirect)
PUBLIC_URL=https://calendar.example.com
DOMAIN=calendar.example.com
DEFAULT_TIMEZONE=America/New_York
DB_PATH=/data/calendar.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: where to POST event.created / updated / cancelled (can also be set via PUT /v1/settings)
WEBHOOK_URL=
# Optional: HMAC secret for webhook signatures (defaults to API_KEY)
WEBHOOK_SECRET=
S3_BUCKET=
