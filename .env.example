# Used by docker-compose.yml. Both values are public (safe to keep in plain text).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional
# DATABASE_URL=       a Postgres connection string for calendar-service (default: embedded database)
# SMTP_URL=           real invitation emails, e.g. AWS SES SMTP (default: logged only)
# DEFAULT_TIMEZONE=America/New_York
