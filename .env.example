# Used by docker-compose.yml. Both values are public (safe to keep in plain text).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional
# DATABASE_URL=       a Postgres connection string for calendar-service (default: embedded database)
# SMTP_URL=           real invitation emails, e.g. AWS SES SMTP (default: logged only)
# DEFAULT_TIMEZONE=America/New_York
# USERS_SERVICE_API_KEY=  shared secret so dashboard-service can email a student's guardian when a grade is published
#                         (users-service reads it as SERVICE_API_KEY). Generate: openssl rand -hex 32. Empty = no parent emails.
# FILES_BUCKET=         private Cloudflare R2 / S3 bucket for students' uploaded work (default: the database). Also FILES_ENDPOINT (R2 only), FILES_REGION, FILES_ACCESS_KEY_ID, FILES_SECRET_ACCESS_KEY
# BILLING_SERVICE_KEY=  turns billing on (plans, free first class, 15 classes a month). Generate: openssl rand -hex 32. Also set
#                       COMPOSE_PROFILES=billing, USERS_SERVICE_API_KEY (billing reads grades through users-service) and BILLING_GATEWAY
#                       (default "fake", for development only; a real gateway needs its own keys, see billing-service/.env.example).
#                       Empty = no billing and every lesson is free.
