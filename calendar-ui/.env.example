# Supabase project (Project Settings > API). The publishable key is safe in a browser; NEVER put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where people log in, manage their account and sign out (the users-ui app)
NEXT_PUBLIC_USERS_UI_URL=http://localhost:3003
# Single sign-on: scope the session cookie to the parent domain in production, e.g. .example.com (leave empty locally).
# Must be the same value users-ui uses.
NEXT_PUBLIC_COOKIE_DOMAIN=
# The two backend services (server-side calls only; each receives the signed-in person's own token)
CALENDAR_API_URL=http://localhost:3000
USERS_SERVICE_URL=http://localhost:3010
# Optional: this app's public address, if it sits behind a proxy that hides it (used for the "come back here" link)
NEXT_PUBLIC_APP_URL=
