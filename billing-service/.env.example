PORT=3012

# Empty DATABASE_URL = an embedded Postgres in ./data/pglite (local development). Production: the Supabase session-pooler URL.
DATABASE_URL=
DATABASE_SSL=
DATABASE_CA_CERT=
SUPABASE_URL=

# calendar-service and users-service call this service with this key. Generate: openssl rand -hex 32
BILLING_SERVICE_KEY=

# Which payment gateway new checkouts use. "fake" is for development. A new provider = one file in src/gateways + one line in
# src/gateways/index.ts. While switching, keep the old one receiving webhooks: BILLING_GATEWAYS_ALSO=old
BILLING_GATEWAY=fake
BILLING_GATEWAYS_ALSO=

# A student's grade (and so their price) is read from users-service.
USERS_SERVICE_URL=http://localhost:3010
USERS_SERVICE_API_KEY=
# Where hosted payment pages send people back to
BILLING_RETURN_URL=http://localhost:3003/billing
